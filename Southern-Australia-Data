        "!pip -q install nemosis\n",
        "\n",
        "import os\n",
        "import pandas as pd\n",
        "from nemosis import dynamic_data_compiler\n",
        "\n",
        "START = \"2022/01/01 00:00:00\"\n",
        "END = \"2026/08/31 23:55:00\"\n",
        "\n",
        "CACHE = \"/content/aemo_cache\"\n",
        "OUT = \"/content/aemo_csv\"\n",
        "\n",
        "os.makedirs(CACHE, exist_ok=True)\n",
        "os.makedirs(OUT, exist_ok=True)"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "price = dynamic_data_compiler(\n",
        "    START, END,\n",
        "    \"DISPATCHPRICE\",\n",
        "    CACHE,\n",
        "    select_columns=[\n",
        "        \"SETTLEMENTDATE\",\n",
        "        \"REGIONID\",\n",
        "        \"INTERVENTION\",\n",
        "        \"RRP\"\n",
        "    ],\n",
        "    filter_cols=[\"REGIONID\", \"INTERVENTION\"],\n",
        "    filter_values=([\"SA1\"], [0]),\n",
        "    fformat=\"csv\",\n",
        "    keep_csv=True\n",
        ")\n",
        "\n",
        "price[\"SETTLEMENTDATE\"] = pd.to_datetime(\n",
        "    price[\"SETTLEMENTDATE\"]\n",
        ")\n",
        "\n",
        "price = price.sort_values(\"SETTLEMENTDATE\")\n",
        "\n",
        "price_hourly = (\n",
        "    price.set_index(\"SETTLEMENTDATE\")\n",
        "    .groupby(\"REGIONID\")[\"RRP\"]\n",
        "    .resample(\"1h\", label=\"right\", closed=\"right\")\n",
        "    .mean()\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "price_hourly.to_csv(\n",
        "    f\"{OUT}/SA_RRP_hourly.csv\", index=False\n",
        ")\n",
        "\n",
        "print(price_hourly.head())\n",
        "print(\"Rows:\", len(price_hourly))"
      ],
